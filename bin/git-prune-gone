#!/usr/bin/env bash
set -euo pipefail

git fetch -p -P

main_wt=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
default=$(git symbolic-ref -q --short refs/remotes/origin/HEAD || true)

# Returns 0 if $1 is merged into $default, by ancestry or as a squash merge.
is_merged() {
  local branch=$1 base squashed
  [ -n "$default" ] || return 1
  git merge-base --is-ancestor "$branch" "$default" && return 0
  base=$(git merge-base "$default" "$branch") || return 1
  squashed=$(git commit-tree "$branch^{tree}" -p "$base" -m _)
  [[ $(git cherry "$default" "$squashed") == -* ]]
}

git for-each-ref --format='%(refname:short)|%(upstream:track)|%(worktreepath)' refs/heads |
while IFS='|' read -r branch track wt; do
  [ "$track" = "[gone]" ] || continue
  if [ "$wt" = "$main_wt" ]; then
    echo "skipping $branch (checked out in main worktree $wt; switch branches first)"
    continue
  fi
  if [ -n "$wt" ]; then
    git worktree remove "$wt" || { echo "skipping $branch (couldn't remove worktree $wt)"; continue; }
  fi
  if ! is_merged "$branch"; then
    echo "warning: $branch is not merged into ${default:-origin/HEAD (unset)}; restore with: git branch $branch $(git rev-parse --short "$branch")" >&2
  fi
  git branch -D "$branch"
done
